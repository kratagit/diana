{
  "name": "diana",
  "productName": "DIANA",
  "private": true,
  "description": "DIANA – diagnostyka i analiza układów cyfrowych (D-algorytm)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "przyklady": "node buduj_przyklady.js",
    "dist": "node buduj_przyklady.js && electron-builder --win portable -c.extraMetadata.version=0.0.0"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.kratagit.diana",
    "files": ["main.js", "web/**"],
    "directories": { "output": "dist" },
    "portable": { "artifactName": "DIANA.exe" }
  }
}
